<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  {{!-- viewport-fit=cover lets us draw under iOS notches/home-bar. --}}
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0d6efd">
  <meta name="description" content="Bazooka — guess the song from the lyric. 10 rounds, 30 seconds each.">
  <title>Bazooka — Guess That Song</title>

  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin>

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  {{!-- Hagrid Trial — used by the Bazooka wordmark. Trial license: non-commercial only. --}}
  <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/hagrid-trial">

  <style>
    /* foundations */
    :root { color-scheme: light; }
    html { scroll-behavior: smooth; }
    body {
      font-feature-settings: "kern", "liga", "calt";
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    main { flex: 1 0 auto; }

    /* typography */
    h1, h2, .balance { text-wrap: balance; }
    .lyric { text-wrap: pretty; }
    .num { font-variant-numeric: tabular-nums; }

    /* buttons */
    .btn {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      transition:
        transform 120ms cubic-bezier(0.215, 0.61, 0.355, 1),
        background-color 120ms ease,
        box-shadow 120ms ease;
    }
    .btn:active { transform: scale(0.97); }

    /* focus ring */
    :focus-visible {
      outline: 2px solid #0d6efd;
      outline-offset: 2px;
      border-radius: 4px;
    }

    /* entrance animation */
    .fade-in {
      animation: fadeInUp 200ms cubic-bezier(0.215, 0.61, 0.355, 1) both;
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: none; }
    }

    /* score bump */
    .score-bump {
      animation: scoreBump 360ms cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    @keyframes scoreBump {
      0%   { transform: scale(0.94); }
      55%  { transform: scale(1.08); }
      100% { transform: scale(1); }
    }

    /* timer urgent */
    .timer.urgent { color: #dc3545; }
    .timer.urgent #timer-num {
      animation: pulse 600ms ease-in-out infinite;
      display: inline-block;
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.06); }
    }

    /* play screen layout */
    .play-shell {
      max-width: 480px;
      margin-inline: auto;
      padding-bottom: env(safe-area-inset-bottom);
    }

    /* leaderboard #1 highlight */
    .leader-1 { background: rgba(255, 193, 7, 0.12); }

    /* Bazooka wordmark */
    .brand-hero {
      background: var(--bs-primary);
      color: #fff;
      border-radius: 1.25rem;
      padding: clamp(2.5rem, 8vw, 5rem) 1rem;
      text-align: center;
      overflow: hidden;
    }
    .brand-bazooka {
      font-family: 'Hagrid Text Trial', 'Hagrid Trial', system-ui, sans-serif;
      font-style: italic;
      font-weight: 700;
      font-size: clamp(3.5rem, 13vw, 7.5rem);
      line-height: 1;
      letter-spacing: -0.015em;
      color: #fff;
      -webkit-text-stroke: 0.09em #000;
      /* paint stroke UNDER fill so letters keep full width */
      paint-order: stroke fill;
      margin: 0;
      display: inline-block;
    }
    .brand-pill {
      display: inline-block;
      margin-top: clamp(0.75rem, 2vw, 1.25rem);
      background: #fff;
      color: #111;
      border-radius: 999px;
      padding: 0.5rem 1.25rem;
      font-weight: 600;
      font-size: clamp(0.95rem, 1.6vw, 1.1rem);
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05);
    }

    /* skip link */
    .skip-link {
      position: absolute;
      left: -999px;
      top: 0;
    }
    .skip-link:focus {
      left: 0.5rem;
      top: 0.5rem;
      background: #fff;
      padding: 0.5rem 0.75rem;
      border-radius: 4px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      z-index: 1080;
    }

    /* reduced-motion kill switch */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
      }
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body>

  <a class="skip-link" href="#main">Skip to content</a>

  <header>
    <nav class="navbar navbar-expand-md navbar-dark bg-primary" aria-label="Primary">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">Bazooka</a>
        <span class="navbar-text small text-white-50 d-none d-md-inline">
          Guess the song. Beat the clock.
        </span>
      </div>
    </nav>
  </header>

  {{!-- Triple braces = unescaped (the inner template IS HTML). --}}
  <main id="main" class="container py-4 fade-in">
    {{{body}}}
  </main>

  <footer class="container py-3 text-muted small text-center border-top mt-4">
    Bazooka — a Pratt INFO 638 class project.
  </footer>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    defer></script>
</body>
</html>
