{{!--
  finish.handlebars
  Renders at GET /game/finish, AFTER the transaction has committed.

  Peak-end design (Kahneman): the player's last impression is dominated by
  the BIG score and the round-by-round review showing what they got right.
  Two action buttons at the bottom — Play Again (primary) + Back to
  Leaderboard (secondary).
--}}

<section class="mx-auto" style="max-width: 720px;">

  {{!-- ---- hero card with the big score ---- --}}
  <div class="card shadow-sm mb-4">
    <div class="card-body p-4 text-center">
      <h1 class="display-5 fw-bold mb-1">Game Over</h1>
      <p class="text-muted mb-3">Nice run, <strong>{{nickname}}</strong>.</p>

      <div class="display-1 fw-bold num score-bump my-2" aria-live="polite">
        {{totalScore}}
      </div>
      <p class="text-muted mb-0">
        out of <span class="num">{{maxScore}}</span> possible
      </p>
    </div>
  </div>

  {{!-- ---- per-round review table ---- --}}
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
      <h2 class="h5 mb-0">Round Breakdown</h2>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" style="width: 3.5rem;">#</th>
              <th scope="col">Song</th>
              <th scope="col" class="text-center">Result</th>
              <th scope="col" class="text-end">Points</th>
              <th scope="col" class="text-end d-none d-sm-table-cell">Time</th>
            </tr>
          </thead>
          <tbody>
            {{#each rounds}}
              <tr>
                <td class="num text-muted">{{inc @index}}</td>
                <td>
                  <strong>{{this.song_title}}</strong><br>
                  <small class="text-muted">{{this.artist_name}}</small>
                </td>
                <td class="text-center">
                  {{#if this.was_correct}}
                    <span class="badge text-bg-success">Correct</span>
                  {{else}}
                    <span class="badge text-bg-danger">Wrong</span>
                  {{/if}}
                </td>
                <td class="num text-end fw-semibold">{{this.points_awarded}}</td>
                <td class="num text-end text-muted d-none d-sm-table-cell">{{this.time_taken_seconds}}s</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {{!-- ---- actions ---- --}}
  <div class="d-flex flex-column flex-sm-row gap-2">

    {{!--
      "Play Again" is a real <button type="submit"> inside a form so it can
      be a POST (mutates session state). POST + redirect avoids the back
      button replaying it.
    --}}
    <form method="POST" action="/game/restart" class="flex-grow-1">
      <button type="submit" class="btn btn-primary btn-lg w-100">Play Again</button>
    </form>

    {{!-- Back to Leaderboard is just navigation, so a real <a> — Cmd-click and middle-click work. --}}
    <a href="/" class="btn btn-outline-secondary btn-lg flex-grow-1">Back to Leaderboard</a>
  </div>

</section>
