<section class="play-shell">

  {{!-- status --}}
  <div class="mb-3">
    <div
      class="progress mb-2"
      role="progressbar"
      aria-label="Round progress"
      aria-valuenow="{{progressPct}}"
      aria-valuemin="0"
      aria-valuemax="100"
      style="height: 6px;">
      <div class="progress-bar" style="width: {{progressPct}}%;"></div>
    </div>
    <div class="d-flex justify-content-between align-items-center small text-muted">
      <span>Round <span class="num">{{roundNumber}}</span> of <span class="num">{{totalRounds}}</span></span>
      <span>
        Score:
        <span id="score" class="num fw-semibold text-body" aria-live="polite">{{totalScore}}</span>
      </span>
    </div>
  </div>

  {{!-- timer --}}
  <div
    id="timer"
    class="timer text-center display-4 fw-bold my-3 num"
    aria-label="Time remaining">
    <span id="timer-num">{{roundSeconds}}</span><span aria-hidden="true">s</span>
  </div>

  {{!-- audio --}}
  <div class="card shadow-sm mb-3">
    <div class="card-body p-4 text-center">
      <p class="text-uppercase text-muted small mb-3 fw-semibold" style="letter-spacing: 0.05em;">
        Listen and guess the song
      </p>
      <audio
        id="preview"
        src="{{previewUrl}}"
        controls
        preload="auto"
        playsinline
        aria-label="30-second song preview"
        class="w-100">
      </audio>
    </div>
  </div>

  {{!-- guess form --}}
  <form id="guess-form" method="POST" action="/game/guess" novalidate>
    <label for="guess" class="form-label fw-semibold">What song is this?</label>
    <input
      id="guess"
      name="guess"
      type="text"
      class="form-control form-control-lg"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      inputmode="text"
      placeholder="Song title&hellip;"
      required
      autofocus>
    <div class="form-text mb-3">Faster guesses earn more points.</div>
    <button type="submit" class="btn btn-success btn-lg w-100">Submit Guess</button>
  </form>

</section>

{{!-- Countdown + auto-submit. Server re-checks elapsed on POST; this is UX only. --}}
<script>
  (function () {
    var totalSeconds = {{roundSeconds}};

    var timerEl = document.getElementById('timer');
    var numEl = document.getElementById('timer-num');
    var formEl = document.getElementById('guess-form');
    var audioEl = document.getElementById('preview');

    if (!timerEl || !numEl || !formEl) return;

    if (audioEl) {
      audioEl.volume = 0.7;
      var attempt = audioEl.play();
      if (attempt && typeof attempt.catch === 'function') {
        // Autoplay may be blocked; visible <audio controls> is the fallback.
        attempt.catch(function () {});
      }
    }

    var remaining = totalSeconds;
    var submitted = false;
    var intervalId = null;

    function tick() {
      remaining -= 1;
      if (remaining < 0) remaining = 0;

      numEl.textContent = remaining;

      if (remaining <= 5) {
        timerEl.classList.add('urgent');
      }

      if (remaining <= 0) {
        clearInterval(intervalId);
        submitForm();
      }
    }

    function submitForm() {
      if (submitted) return;
      submitted = true;
      // requestSubmit() falls back to submit() for Safari < 16.
      try { formEl.requestSubmit(); }
      catch (e) { formEl.submit(); }
    }

    formEl.addEventListener('submit', function () {
      submitted = true;
      if (intervalId) clearInterval(intervalId);
    });

    // bfcache restore (mobile back button) — reset the visible state.
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) {
        remaining = totalSeconds;
        numEl.textContent = remaining;
        timerEl.classList.remove('urgent');
      }
    });

    intervalId = setInterval(tick, 1000);
  })();
</script>

{{!-- Unicorn Studio ambient background, scoped to /game/play. --}}
<div
  class="us-bg"
  data-us-project="ZMZwNgENYZkLEZ4QQUUe"
  data-us-scale="1"
  data-us-dpi="1.5"
  data-us-fixed="true"
  data-us-production="true"
  aria-hidden="true"></div>

<style>
  .us-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: -1;
    pointer-events: none;
  }
  body, main { background: transparent !important; }
  @media (prefers-reduced-motion: reduce) { .us-bg { display: none; } }
</style>

<script>
  (function () {
    // Skip WebGL entirely for reduced-motion users.
    if (window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }
    function start() {
      if (window.UnicornStudio && typeof window.UnicornStudio.init === 'function') {
        window.UnicornStudio.init();
      }
    }
    if (window.UnicornStudio && window.UnicornStudio.init) {
      start();
      return;
    }
    window.UnicornStudio = { isInitialized: false };
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v2.1.12/dist/unicornStudio.umd.js';
    s.onload = start;
    (document.head || document.body).appendChild(s);
  })();
</script>
